DB_PASSWORD=change-this-long-random-password
APP_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8088
WEB_PORT=8088
# Maximum size of each uploaded file, in MB (1-100). The interface checks it before sending.
MAX_UPLOAD_MB=20
# Used with compose.prod.yaml and the existing EasyPanel/Traefik network.
COMMITNOTES_DOMAIN=commitnotes.rklooh.easypanel.host
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password-at-least-12-chars
# Configure SMTP to enable password reset e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
# Configure VAPID and HTTPS to enable background push notifications.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:no-reply@example.com
