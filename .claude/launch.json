{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["-o", "-q", "-f", "backend/pom.xml", "test-compile", "exec:java", "-Dexec.mainClass=com.commitnotes.DevLauncher", "-Dexec.classpathScope=test"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "web-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    }
  ]
}
